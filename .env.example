# Copy to .env and adjust. Never commit .env.

MQTT_ENDPOINT=mqtt.example.lan
#MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# The Shelly's MQTT topic prefix + /events/rpc. Wildcards work too, e.g.
# +/events/rpc for every Shelly on the broker (the prefix becomes the
# `device` label).
MQTT_TOPIC_FILTER=shellyhtg3-lr/events/rpc

# Log every received message
#PRINT_ALL_MSGS=false

# Port on the host for /metrics
#HOST_PORT=8888
